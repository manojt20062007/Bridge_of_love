{
  "name": "bridge-of-love",
  "version": "1.0.0",
  "private": true,
  "description": "Bridge Of Love — Charitable Trust Management Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --parallel",
    "dev:api": "npm run dev --workspace=apps/api-server",
    "dev:web": "npm run dev --workspace=apps/web",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api-server",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api-server",
    "prisma:seed": "npm run prisma:seed --workspace=apps/api-server"
  },
  "keywords": [
    "charity",
    "trust-management",
    "donations",
    "razorpay",
    "mern",
    "pern"
  ],
  "author": "Bridge Of Love Trust",
  "license": "UNLICENSED"
}
