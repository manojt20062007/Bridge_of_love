generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. User & Identity Management
// ==========================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  mobile           String
  status           UserStatus   @default(ACTIVE)
  isEmailVerified  Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  profile                  MemberProfile?
  userRoles                UserRole[]
  sessions                 Session[]
  refreshTokens            RefreshToken[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  donations                Donation[]
  createdExpenses          Expense[]                @relation("CreatedBy")
  approvedExpenses         Expense[]                @relation("ApprovedBy")
  notifications            Notification[]
  auditLogs                AuditLog[]

  @@index([email])
  @@index([status])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // ADMIN, MEMBER, SUPER_ADMIN
  description String?
  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model MemberProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  fullName   String
  address    String?
  city       String?
  state      String?
  postalCode String?
  panNumber  String?
  avatarUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model RefreshToken {
  id              String    @id @default(uuid())
  userId          String
  tokenHash       String    @unique
  isRevoked       Boolean   @default(false)
  expiresAt       DateTime
  replacedByToken String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ==========================================
// 2. Campaigns & Causes
// ==========================================

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  PAUSED
}

model Campaign {
  id                     String         @id @default(uuid())
  title                  String
  slug                   String         @unique
  summary                String
  description            String         @db.Text
  coverImage             String
  targetAmount           Decimal        @db.Decimal(12, 2)
  raisedAmount           Decimal        @default(0.00) @db.Decimal(12, 2)
  startDate              DateTime
  endDate                DateTime?
  status                 CampaignStatus @default(ACTIVE)
  isFeatured             Boolean        @default(false)
  beneficiaryDescription String?        @db.Text
  category               String
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  donations Donation[]
  expenses  Expense[]

  @@index([slug])
  @@index([status])
  @@index([isFeatured])
}

// ==========================================
// 3. Donations & Payments
// ==========================================

enum DonationType {
  GENERAL
  CAMPAIGN
  OFFLINE_CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
}

model Donation {
  id                String        @id @default(uuid())
  userId            String?
  donorName         String
  donorEmail        String
  donorMobile       String
  donorAddress      String?
  donorPan          String?
  campaignId        String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  donationType      DonationType  @default(GENERAL)
  paymentMethod     PaymentMethod @default(RAZORPAY)
  isAnonymous       Boolean       @default(false)
  notes             String?
  status            PaymentStatus @default(CREATED)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  payments Payment[]
  receipt  Receipt?

  @@index([userId])
  @@index([campaignId])
  @@index([status])
  @@index([razorpayOrderId])
  @@index([donorEmail])
}

model Payment {
  id                String        @id @default(uuid())
  donationId        String
  gateway           String        @default("RAZORPAY")
  gatewayOrderId    String
  gatewayPaymentId  String?
  gatewaySignature  String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  rawWebhookPayload String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([donationId])
  @@index([gatewayOrderId])
}

// ==========================================
// 4. Receipts & Verification
// ==========================================

enum ReceiptStatus {
  ISSUED
  CANCELLED
}

model Receipt {
  id                   String        @id @default(uuid())
  receiptNumber        String        @unique // Collision-safe sequential e.g. BOL-2026-000001
  donationId           String        @unique
  issueDate            DateTime      @default(now())
  donorName            String
  donorEmail           String
  donorMobile          String
  donorAddress         String?
  donorPan             String?
  amount               Decimal       @db.Decimal(12, 2)
  amountInWords        String
  purpose              String
  paymentMethod        PaymentMethod
  transactionReference String
  verificationCode     String        @unique
  pdfPath              String?
  status               ReceiptStatus @default(ISSUED)
  is80GApplicable      Boolean       @default(true)
  trustPan             String
  trust80GReg          String?
  cancelledAt          DateTime?
  cancellationReason   String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Restrict)

  @@index([receiptNumber])
  @@index([verificationCode])
  @@index([donorEmail])
}

// ==========================================
// 5. Income, Expenses & Double-Entry Ledger
// ==========================================

enum IncomeSource {
  ONLINE_DONATION
  OFFLINE_DONATION
  BANK_TRANSFER
  GRANT
  MEMBERSHIP_FEE
  OTHER
}

model IncomeEntry {
  id              String       @id @default(uuid())
  title           String
  amount          Decimal      @db.Decimal(12, 2)
  incomeDate      DateTime
  source          IncomeSource
  referenceNumber String?
  notes           String?
  receivedBy      String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([source])
  @@index([incomeDate])
}

enum ExpenseCategory {
  FOOD_DISTRIBUTION
  MEDICAL_ASSISTANCE
  EDUCATION_SUPPORT
  CLOTHING
  SHELTER
  EMERGENCY_RELIEF
  ADMINISTRATION
  TRANSPORTATION
  EVENTS
  UTILITIES
  OTHER
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

model Expense {
  id              String          @id @default(uuid())
  expenseNumber   String          @unique // e.g. EXP-2026-0001
  title           String
  description     String          @db.Text
  category        ExpenseCategory
  amount          Decimal         @db.Decimal(12, 2)
  expenseDate     DateTime
  paymentMethod   PaymentMethod
  paidTo          String
  invoiceNumber   String?
  campaignId      String?
  status          ExpenseStatus   @default(PENDING_APPROVAL)
  createdById     String
  approvedById    String?
  rejectionReason String?
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdBy   User                @relation("CreatedBy", fields: [createdById], references: [id])
  approvedBy  User?               @relation("ApprovedBy", fields: [approvedById], references: [id])
  campaign    Campaign?           @relation(fields: [campaignId], references: [id])
  attachments ExpenseAttachment[]

  @@index([status])
  @@index([category])
  @@index([expenseDate])
  @@index([createdById])
  @@index([expenseNumber])
}

model ExpenseAttachment {
  id        String   @id @default(uuid())
  expenseId String
  fileName  String
  fileUrl   String
  mimeType  String
  fileSize  Int
  createdAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

model FinancialLedgerEntry {
  id            String          @id @default(uuid())
  entryType     LedgerEntryType
  amount        Decimal         @db.Decimal(12, 2)
  balanceAfter  Decimal         @db.Decimal(12, 2)
  account       String          @default("MAIN_OPERATIONAL_FUND")
  referenceType String // DONATION, INCOME, EXPENSE, ADJUSTMENT
  referenceId   String
  description   String
  recordedAt    DateTime        @default(now())

  @@index([entryType])
  @@index([referenceType, referenceId])
  @@index([recordedAt])
}

// ==========================================
// 6. Content: Activities, Gallery, Testimonials
// ==========================================

model Activity {
  id                 String   @id @default(uuid())
  title              String
  slug               String   @unique
  description        String   @db.Text
  category           String
  date               DateTime
  location           String
  coverImage         String
  images             String[]
  beneficiariesCount Int      @default(0)
  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model GalleryItem {
  id         String   @id @default(uuid())
  title      String
  category   String
  imageUrl   String
  caption    String?
  date       DateTime
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([category])
  @@index([isFeatured])
}

model Testimonial {
  id             String   @id @default(uuid())
  name           String
  roleOrRelation String
  quote          String   @db.Text
  avatarUrl      String?
  location       String?
  isApproved     Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([isApproved])
}

model ContactMessage {
  id          String    @id @default(uuid())
  name        String
  email       String
  mobile      String?
  subject     String
  message     String    @db.Text
  isRead      Boolean   @default(false)
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model WebsiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ==========================================
// 7. Audit Logging & System Notifications
// ==========================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userName   String?
  action     String
  entityType String
  entityId   String
  oldValues  String?  @db.Text
  newValues  String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ALERT
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

// ==========================================
// 8. Atomic Sequential Numbering Tracker
// ==========================================

model SequenceTracker {
  id         String   @id @default(uuid())
  name       String   @unique // RECEIPT, EXPENSE
  year       Int
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([name, year])
}
