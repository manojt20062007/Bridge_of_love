# Application Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:admin@localhost:5433/bridge_of_love?schema=public

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=bridge_of_love_access_secret_production_ready_token_2026
JWT_REFRESH_SECRET=bridge_of_love_refresh_secret_production_ready_token_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway (Razorpay)
# For local dev / testing, simulation mock is also built-in if real keys are absent
RAZORPAY_KEY_ID=rzp_test_bol_mock_key
RAZORPAY_KEY_SECRET=rzp_test_bol_mock_secret
RAZORPAY_WEBHOOK_SECRET=bol_mock_webhook_secret

# Email Service (Nodemailer)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=noreply@bridgeoflove.org
SMTP_PASS=secret_smtp_password
SMTP_FROM="Bridge Of Love Trust" <receipts@bridgeoflove.org>

# Trust Legal & Verification Details
TRUST_NAME="Bridge Of Love Charitable Trust"
TRUST_TAGLINE="Connecting compassionate hearts with people in need"
TRUST_REG_NO="BOL/TN/2021/004921"
TRUST_PAN="AAATB1234F"
TRUST_80G_REG="AAATB1234FF20214"
TRUST_12A_REG="AAATB1234FE20213"
TRUST_ADDRESS="Plot No. 42, Karuna Nagar, 3rd Main Road, Anna Nagar West, Chennai, Tamil Nadu - 600040"
TRUST_PHONE="+91 94441 23456"
